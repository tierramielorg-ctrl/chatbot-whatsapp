# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a usar. claude-sonnet-5 es el equilibrio recomendado costo/calidad para un bot conversacional.
CLAUDE_MODEL=claude-sonnet-5

# ---- WhatsApp Cloud API (Meta) ----
# Access token permanente de tu app de Meta (System User token, no el temporal de 24h)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Phone Number ID (no es el numero de telefono, es el ID que muestra el panel de Meta)
WHATSAPP_PHONE_NUMBER_ID=1234567890
# String que tu mismo inventas; debe coincidir con el que pongas en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=elige-una-clave-secreta-larga
# App Secret de tu app de Meta, para verificar la firma de los webhooks entrantes (recomendado)
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Version de la Graph API
WHATSAPP_API_VERSION=v20.0

# ---- Shopify ----
# Dominio *.myshopify.com de la tienda (no el dominio custom tierramiel.org)
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
# Se obtiene una sola vez visitando /shopify/install?shop=tu-tienda.myshopify.com
# (requiere SHOPIFY_CLIENT_ID y SHOPIFY_CLIENT_SECRET configurados abajo)
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10
# Client ID y Secret de la Custom App creada en dev.shopify.com (pestana Configuracion > Credenciales)
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Automatizaciones post-compra ----
# Nombres exactos de las plantillas aprobadas en Meta (WhatsApp Manager > Plantillas)
WHATSAPP_TEMPLATE_PERSONALIZATION=tierra_miel_personalizacion
WHATSAPP_TEMPLATE_USAGE=tierra_miel_modo_de_uso
WHATSAPP_TEMPLATE_TRACKING=tierra_miel_seguimiento
WHATSAPP_TEMPLATE_WELCOME=tierra_miel_bienvenida
WHATSAPP_TEMPLATE_REVIEW=tierra_miel_resena
WHATSAPP_TEMPLATE_LANG=es
# Dias corridos despues de mandar el mensaje de modo de uso, para pedir la resena
REVIEW_DELAY_DAYS=7
# Codigo de descuento (armado en Discountos u otra herramienta) que se menciona en la plantilla de resena
DISCOUNT_CODE_REVIEW=RESENA10
# Link opcional a donde dejar la resena (si esta vacio, el mensaje queda generico)
REVIEW_LINK=
# API key de Resend (resend.com) para notificaciones internas por email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_EMAIL=tierramiel.org@gmail.com
# URLs publicas de los audios (se completan cuando Tierra Miel los grabe y suba)
SEBASTIAN_WELCOME_AUDIO_URL=
CAROLINA_CLOSING_AUDIO_URL=

# ---- Panel de admin (ver/responder conversaciones manualmente) ----
ADMIN_USERNAME=tierramiel
ADMIN_PASSWORD=elige-una-clave-segura

# ---- Server ----
PORT=3000
